{
  "name": "pokemon-auto-battler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "simulate": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "server": "tsx watch src/server/index.ts",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@pkmn/sim": "^0.10.11",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
