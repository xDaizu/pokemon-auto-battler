# Copy to .env and fill in. `npm run migrate` creates the local database file
# on first run — there is nothing to install or start beforehand.

# Local dev: a plain libSQL/SQLite file, created automatically.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Production (Turso-hosted) — same client, same SQL dialect, just a different URL:
# DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<turso db tokens create <your-db>>

# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=

# `production` makes the session cookie HTTPS-only — and makes SESSION_SECRET
# mandatory instead of falling back to the insecure development default.
NODE_ENV=development

# Path prefix the API answers on. Empty locally; `/battler` in production, where
# the Firebase Hosting rewrite forwards the full original path to Cloud Run.
BASE_PATH=

# Production only — the GCP/Firebase project id. Read by scripts/deploy-api.ps1
# and referenced as $env:GCP_PROJECT_ID in docs/RELEASING.md's manual commands.
# Also stored as the GCP_PROJECT_ID CI variable (docs/PROVISIONING.md §8).
# GCP_PROJECT_ID=
